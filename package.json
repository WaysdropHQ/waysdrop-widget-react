{
    "name": "@waysdrop/widget-react",
    "version": "0.1.0",
    "description": "React bindings for the embeddable Waysdrop widget",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=17"
    },
    "devDependencies": {
        "@types/react": "^18.3.0",
        "react": "^18.3.1",
        "typescript": "^5.6.0"
    },
    "keywords": [
        "waysdrop",
        "delivery",
        "logistics",
        "widget",
        "react",
        "api"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
